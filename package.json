{
  "name": "slotbook",
  "private": true,
  "description": "Appointment booking for salons and clinics — a full-stack learning project",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @slotbook/api",
    "test": "npm run test -w @slotbook/api",
    "typecheck": "npm run typecheck -w @slotbook/api",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
