# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Local Docker Postgres (see docker-compose.yml), or paste a free hosted one
# from Neon / Supabase (use the "direct" connection string, not the pooler).
DATABASE_URL=postgresql://slotbook:slotbook@localhost:5432/slotbook

# Generate a long random secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# Your frontend's URL (Vite default shown)
CORS_ORIGIN=http://localhost:5173

# Redis for the reminder queue (the Docker container from docker-compose.yml)
REDIS_URL=redis://localhost:6379

# Optional: a key from resend.com to send real emails. Leave empty to just
# print emails to the console while developing.
RESEND_API_KEY=

# Razorpay TEST keys (Dashboard > Test Mode > Account & Settings > API Keys).
# Leave empty to run without deposits. Never commit real values.
# The webhook secret is the one you type when adding a webhook (Dashboard > Webhooks).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MAIL_FROM=SlotBook <onboarding@resend.dev>

# debug | info | warn | error | silent
LOG_LEVEL=info

# How many reverse proxies sit in front of the API (0 locally; usually 1 on Render/Railway).
# Needed so rate limits count real visitors, not the proxy. Never set it higher than the truth.
TRUST_PROXY=0
